# 复制为 .env 后使用；已有文件时不要覆盖。
# 模型和地址优先在 config.yaml 中配置，这里填写所用服务的密钥。
# .env 已被 Git 忽略；请勿在本模板中填写真实密钥。

# 只填写所用服务的一个密钥，其他留空。
# OpenAI 及兼容服务使用 OPENAI_API_KEY；DeepSeek 也可用 DEEPSEEK_API_KEY。
# 同时非空时的优先级：ANTHROPIC_API_KEY > OPENAI_API_KEY > DEEPSEEK_API_KEY。
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# 可选覆盖项：取消注释后将覆盖 config.yaml，已设置的进程环境变量优先。
# 切换服务时，请同步调整模型、provider、地址和密钥。
# MODEL_ID=your-model-id
# CODING_AGENT_PROVIDER=openai_compat
# OPENAI_BASE_URL=https://api.openai.com/v1

# 使用 Anthropic 时，取消以下注释并填写实际模型，清除其他服务的地址配置。
# CODING_AGENT_PROVIDER=anthropic
# MODEL_ID=your-anthropic-model-id
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# 同时非空时，ANTHROPIC_BASE_URL 优先于 OPENAI_BASE_URL。

# 可选运行参数；工作目录默认为启动目录。
# MAX_TOKENS=8000
# CODING_AGENT_WORKDIR=.
# SYSTEM_PROMPT="You are a coding agent. Use tools to solve tasks."
